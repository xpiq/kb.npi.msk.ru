URL=https://wiki.npi.msk.ru
SECRET_KEY=replace_with_64_hex_chars
UTILS_SECRET=replace_with_64_hex_chars

POSTGRES_PASSWORD=replace_with_postgres_password
DATABASE_URL=postgres://outline:replace_with_postgres_password@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

FILE_STORAGE=s3
FILE_STORAGE_UPLOAD_MAX_SIZE=26214400
AWS_ACCESS_KEY_ID=replace_with_storj_access_key
AWS_SECRET_ACCESS_KEY=replace_with_storj_secret_key
AWS_REGION=global-1
AWS_S3_UPLOAD_BUCKET_NAME=web-storage-npi
AWS_S3_UPLOAD_BUCKET_URL=https://gateway.storjshare.io
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

