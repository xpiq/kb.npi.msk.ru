[Unit]
Description=Storj single-tenant S3 gateway for IT Help video
Documentation=https://storj.dev/learn/self-host/gateway-st
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateway-st
Group=gateway-st
ExecStart=/usr/local/bin/gateway --config-dir /var/lib/gateway-st run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gateway-st
CapabilityBoundingSet=
LockPersonality=true
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
